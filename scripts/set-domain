#!/usr/bin/env bash
# Points the app at a Community4All site: writes assets/.env and the deep-link host for Android and iOS.
# Usage: scripts/set-domain community.example.org
# Then rebuild. Installed apps keep the old site until they update.
set -euo pipefail
cd "$(dirname "$0")/.."

host=${1:?Usage: scripts/set-domain <host, without https://>}
host=${host#https://}; host=${host%%/*}

# Read by lib/flavored (HumHubF, ManifestF). Colours go without '#', which starts a comment in .env.
# THEME_COLOR fills the strip behind the phone's status bar: the site's light top bar, so the clock stays readable.
cat > assets/.env <<EOF
MANIFEST_URL=https://$host
START_URL=https://$host
NAME=Community4All
SHORT_NAME=Community4All
DISPLAY=standalone
BACKGROUND_COLOR=f2ede6
THEME_COLOR=fef3f2
EOF

# App Links / Universal Links: links to the site open in the app once the site serves
# assetlinks.json and apple-app-site-association for this app (set up at store release).
sed -i.bak -E "/android:autoVerify=\"true\"/,/<\/intent-filter>/ s/android:host=\"[^\"]+\"/android:host=\"$host\"/" \
  android/app/src/main/AndroidManifest.xml
for f in ios/Runner/Runner.entitlements ios/Runner/RunnerProfile.entitlements; do
  sed -i.bak -E "s#<string>applinks:[^<]+</string>#<string>applinks:$host</string>#" "$f"
done
rm -f android/app/src/main/AndroidManifest.xml.bak ios/Runner/*.entitlements.bak

echo "App now points at https://$host"
